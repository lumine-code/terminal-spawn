{
  "context-menu": {
    ".tree-view .full-menu:not(.multi-select) .file, .tree-view .full-menu:not(.multi-select) .directory": [
      {
        "type": "separator"
      },
      {
        "label": "Terminal",
        "id": "terminal:tree-context",
        "afterGroupContaining": [
          "tree-view-favourite:add",
          "tree-view-favourite:remove",
          "diff-view:enable",
          "jupyter-cells:import-notebook",
          "jupyter-view:open-source",
          "graviss:open-source-on-right",
          "markdown-preview:preview-file",
          "image-editor:open-in-new-tab",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ],
        "submenu": [
          {
            "type": "separator"
          },
          {
            "label": "Spawn New",
            "afterGroupContaining": [
              "terminal:open-split-bottom-dock-context-menu",
              "terminal:open-center-context-menu",
              "terminal:open"
            ],
            "command": "terminal-spawn:open"
          },
          {
            "type": "separator"
          }
        ]
      },
      {
        "type": "separator"
      }
    ]
  },
  "menu": [
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Terminal Spawn",
          "submenu": [
            {
              "label": "Spawn Terminal Here",
              "command": "terminal-spawn:open"
            },
            {
              "label": "Spawn Terminal at Project Root",
              "command": "terminal-spawn:root"
            },
            {
              "label": "Select Preset…",
              "command": "terminal-spawn:list"
            }
          ]
        }
      ]
    }
  ]
}
