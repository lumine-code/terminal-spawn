{
  "name": "terminal-spawn",
  "author": "lumine-code",
  "description": "Spawn the system terminal in the current file or project directory.",
  "repository": "https://github.com/lumine-code/terminal-spawn",
  "bugs": {
    "url": "https://github.com/lumine-code/terminal-spawn/issues"
  },
  "keywords": [
    "terminal",
    "cmd",
    "shell",
    "console",
    "spawn",
    "external"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../terminal-spawn/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "terminal-spawn": {
      "description": "Spawn the configured external terminal at a path, optionally with a command",
      "versions": {
        "1.0.0": "provideTerminalSpawnService"
      }
    }
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#fbbc2d9660db6a2ff676c7a3baf7536f96ec34e6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
