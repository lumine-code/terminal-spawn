{
  "name": "terminal-spawn",
  "author": "lumine-code",
  "description": "Spawn the system terminal in the current file or project directory.",
  "repository": "https://github.com/lumine-code/terminal-spawn",
  "bugs": {
    "url": "https://github.com/lumine-code/terminal-spawn/issues"
  },
  "keywords": [
    "shell",
    "cmd",
    "console",
    "external",
    "launch",
    "os-terminal"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can open your system terminal in the project root with {{ 'terminal-spawn:root' | keystroke }}"
  ],
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "terminal-spawn": {
      "description": "Spawn the configured external terminal at a path, optionally with a command",
      "versions": {
        "1.0.0": "provideTerminalSpawn"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
